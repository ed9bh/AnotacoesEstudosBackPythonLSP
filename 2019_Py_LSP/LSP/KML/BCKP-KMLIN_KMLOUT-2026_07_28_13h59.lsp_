(defun load-functions()
  
  (defun kmlStarts ()
    (list
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
      "<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n"
      ;"# '<Placemark>\n"
      "<Document>\n"
      "<name>DWGtoKML</name>\n"
      "<atom:author>Eric Drumond - ed9bh</atom:author>\n"
      ;"#<phoneNumber>+55(31)9 9758-2378</phoneNumber>\n"
      "<description>DWGtoKML foi elaborado por Eric Drumond em 2017/04. Programa gratuito. Quer sua marca aqui, outras opções de DATUM e mais personalização? Entre em contato e solicite um orçamento.</description>\n"
      "<address>\"http://br.linkedin.com/in/ericdrumond\"</address>\n"
      "<atom:link href=\"http://br.linkedin.com/in/ericdrumond\"/>\n"
      ;"#+ Styles"
    )
  )
  
  (defun kmlEnds ()
    "</Document>\n</kml>"
  )
  
  (defun kmlHexColor (R G B Transparence)
    (strcat Transparence "x" (rtos B 2 0) "x" (rtos G 2 0) "x" (rtos R 2 0) )
  )
  
  (defun kmlStyle (Name HexColor Width)
    (strcat
      "<Style id="Name">\n"
      "<LineStyle>\n"
      "<color>"HexColor"</color>\n"
      "<width>2</width>\n"
      "</LineStyle>\n"
      "<PolyStyle>\n"
      "<color>"HexColor"</color>\n"
      "<width>"(rtos Width 2 )"</width>\n"
      "<colorMode>normal</colorMode>\n"
      "<fill>1</fill>\n"
      "<outline>1</outline>\n"
      "</PolyStyle>\n"
      "</Style>\n"
    )
  )
    
  (defun kmlLines (CoordinatesList Fuso Emisferio Datum StyleName / Header Footer Body)
    (setq
      Header
       (strcat
         "<Placemark>\n"
         "<name>AutoCADLines</name>\n"
         "<description>By:EricDrumond</description>\n"
         "<styleUrl>StyleName</styleUrl>\n"
         "<LineString>\n"
         "<tessellate>1</tessellate>\n"
         "<altitudeMode>clampToGround</altitudeMode>\n"
         "<coordinates>\n"
       )
      Footer
       (strcat
         "</coordinates>\n"
         "</LineString>\n"
         "</Placemark>\n"
       )
      Body ""
    )
    (foreach UTMPoint CoordinatesList
      (setq
        LatLon(UTM->GEO (car UTMPoint) (cadr UTMPoint) (read Fuso) Emisferio Datum)
        Body(strcat
              Body (rtos (cdr(assoc "LONGITUDE" LatLon)) 2 15) "," (rtos (cdr(assoc "LATITUDE" LatLon)) 2 15) "\n"
            )
       )
    )
    (strcat Header Body Footer)
  )
  
  (defun kmlPoints (CoordinatesList Fuso Emisferio Datum / KmlPointCoordinates)
    (foreach UTMPoint CoordinatesList
      (setq
        LatLon(UTM->GEO (car UTMPoint) (cadr UTMPoint) (read Fuso) Emisferio Datum)
        KmlPointCoordinates
         (vl-list*
           (strcat
             "\n<Placemark>"
             "<name>Ponto de Referencia</name>"
             "<description>Sem Descricao</description>"
             "<Point>"
             "<coordinates>"(rtos (cdr(assoc "LONGITUDE" LatLon)) 2 15)","(rtos (cdr(assoc "LATITUDE" LatLon)) 2 15)"</coordinates>"
             "</Point>"
             "</Placemark>"
           )
           KmlPointCoordinates
         )
      )
    )
    KmlPointCoordinates
  )
  
  (defun kmlPointText (UTMPoint Text / LatLon KmlPointCoordinate)
    (setq
      LatLon(UTM->GEO (car UTMPoint) (cadr UTMPoint) (read Fuso) Emisferio Datum)
      KmlPointCoordinate
       (strcat
         "\n<Placemark>"
         "<name>Ponto de Referencia</name>"
         "<description>Sem Descricao</description>"
         "<Point>"
         "<coordinates>"(rtos (cdr(assoc "LONGITUDE" LatLon)) 2 15)","(rtos (cdr(assoc "LATITUDE" LatLon)) 2 15)"</coordinates>"
         "</Point>"
         "</Placemark>"
       )
    )
    KmlPointCoordinate
  )
  
  (defun RGB_Getter ()
    "..."
  )
  
  (defun RGB_Setter ()
    "..."
  )
  
  (defun string->list ( String delimiter / len lst pos )
    (setq len (1+ (strlen delimiter)))
    (while (setq pos (vl-string-search delimiter String))
      (setq lst (cons (substr String 1 pos) lst)
            String (substr String (+ pos len))
      )
    )
    (reverse (cons String lst))
  )

  (defun Corrdinate_Getter (StringDocument)
    (setq
      StringDocumentSanitizing StringDocument
      StringDocumentSanitizing(vl-string-translate "\t" " " StringDocumentSanitizing)
      StringDocumentSanitizing(vl-string-translate "\n" " " StringDocumentSanitizing)
      STRLen1 (strlen "<coordinates>")
      STRLen2 (strlen StringDocumentSanitizing)
      End 0
      Lines nil
    )
    (while
      (setq Start (vl-string-search "<coordinates>" StringDocumentSanitizing End) )
      (setq
        Start(+ Start STRLen1 1)
        End(vl-string-search "</coordinates>" StringDocumentSanitizing Start)
        Trecho (substr StringDocumentSanitizing Start (- End Start))
      )
      (while
        (vl-string-search "  " Trecho)
        (setq Trecho(vl-string-subst " " "  " Trecho))
      )
      (setq Trecho(vl-string-right-trim " " (vl-string-left-trim " " Trecho)))
      (setq
        Trecho(string->list Trecho " ")
        Line nil
      )
      (foreach item Trecho
        (setq
          LLE(string->list item ",")
          ENZ(GEO->UTM (read(cadr LLE)) (read(car LLE)) Datum (read Fuso) Emisferio)
          Line(vl-list* (list (cdr(car ENZ)) (cdr(cadr ENZ)) (read(caddr LLE)) ) Line)
        )
      )
      (setq Lines(vl-list* (reverse Line) Lines))
    )
    Lines
  )
  
) ; <<<--- load-functions


(defun c:kmlOUT (/ *error* cad doc model file KMLFile)
  
  (defun *error* (msg)
    (close KMLFile)
    (princ msg)
    (vla-endundomark doc)
    (princ)
  )
  
  (defun main()
    (load "C:\\Users\\egomes\\OneDrive - TELLUS COMPANY ENGENHARIA LTDA\\Documentos\\_LSP\\KML\\utm-geo_conversor.lsp")
    ;(load "I:\\PROJETISTAS\\05_LISPS\\KML\\utm-geo_conversor.lsp")
    
    (load-functions)
    
    (initget -1 (setq Fusos "17 18 19 20 21 22 23 24 25"))
    (setq Fuso(getkword (strcat "\nSelecione o FUSO [" (vl-string-translate " " "/" Fusos) "]:> ")))
    
    (initget -1 (setq Emisferios "S N"))(setq Emisferio (getkword "\nEmisferio [Sul/Norte]:"))
    
    (initget -1 (setq DATUMList "Sirgas-2000 sAd-69 Corrego"))
    (setq
      DATUM
       (strcase (getkword (strcat "\nSelecione o DATUM [" (vl-string-translate " " "/" DATUMList) "]")) )
    )
        
    (setq
      file(getfiled "Selecione o arquivo KML..." (getvar'dwgprefix) "KML" 1)
      KMLFile(open file "w" "utf8")
    )
    
    (if file (princ) (exit))
    
    (princ "\nSelecione as entidades a enviar para o google earth:> ")
    (setq
      SS(ssget '((0 . "*line,Point,Text")))
    )
    
    (if
      SS
      (setq
        SS(ssnamex SS)
      )
      (exit)
    )
    
    (foreach line (kmlStarts)
      (write-line line KMLFile)
    )
    
    (foreach item SS
      (if
        (>=(car item)0)
        (progn
          (setq
            Vlao(vlax-ename->vla-object(cadr item))
            CoordinateList nil
            Count -1
          )
          (if
            (=(vla-get-objectname Vlao)"AcDbPolyline")
            (progn ;;; >>> LWPolyline
              (repeat
                (/(length (vlax-get Vlao 'Coordinates))2)
                (setq
                  CoordinateList
                   (vl-list*
                     (vlax-safearray->list(vlax-variant-value (vlax-get-property Vlao 'Coordinate (setq Count(1+ Count)) )))
                     CoordinateList
                   )
                )
              )
              (if(/=(vlax-get Vlao 'Closed)0) (setq CoordinateList(vl-list* (vlax-curve-getstartpoint Vlao) CoordinateList)))
              (setq EveryTypesOfLines(kmlLines CoordinateList Fuso Emisferio Datum StyleName))
              (write-line EveryTypesOfLines KMLFile)
            );;; <<< LWPolyline
            (if
              (=(vla-get-objectname Vlao)"AcDb3dPolyline")
              (progn ;;; >>> 3DPolyline
                (repeat
                  (/(length (vlax-get Vlao 'Coordinates))3)
                  (setq
                    CoordinateList
                     (vl-list*
                       (vlax-safearray->list(vlax-variant-value(vlax-get-property Vlao 'Coordinate (setq Count(1+ Count)) )))
                       CoordinateList
                     )
                  )
                )
                (if(/=(vlax-get Vlao 'Closed)0) (setq CoordinateList(vl-list* (vlax-curve-getstartpoint Vlao) CoordinateList)))
                (setq EveryTypesOfLines(kmlLines CoordinateList Fuso Emisferio Datum StyleName))
                (write-line EveryTypesOfLines KMLFile)
              );;; <<< 3DPolyline
              (if
                (=(vla-get-objectname Vlao)"AcDbLine")
                (progn ;;; <<< Line
                  (setq
                    CoordinateList(list
                                    (vlax-safearray->list(vlax-variant-value(vla-get-startpoint Vlao)))
                                    (vlax-safearray->list(vlax-variant-value(vla-get-endpoint Vlao)))
                                  )
                  )
                  (setq EveryTypesOfLines(kmlLines CoordinateList Fuso Emisferio Datum StyleName))
                  (write-line EveryTypesOfLines KMLFile)
                )
              );;; <<< Line
            )
          )
        )
      )
    )
    
    (write-line (kmlEnds) KMLFile)
    
    ;|
      
      ; Fuso Emisferio DATUM
      
    (vlax-dump-object (setq teste(vlax-ename->vla-object (car (entsel)))) t)
    (vla-get-objectname teste)
    (vla-get-coordinate teste)
    |;
    
    (close KMLFile)
  )
  
  
  (setq
    cad (vlax-get-acad-object)
    doc (vla-get-activedocument cad)
    MSpace (vla-get-modelspace doc)
  )
  
  (vla-startundomark doc)
  (setvar 'cmdecho 0)
  (main)
  (setvar 'cmdecho 1)
  (vla-endundomark doc)
  (princ)
  
)

(defun c:kmlIN (/ *error* cad doc model file KMLFile)
  
  (defun main ()
    (load "C:\\Users\\egomes\\OneDrive - TELLUS COMPANY ENGENHARIA LTDA\\Documentos\\_LSP\\KML\\utm-geo_conversor.lsp")
    ;(load "I:\\PROJETISTAS\\05_LISPS\\KML\\utm-geo_conversor.lsp")
    
    (load-functions)
    
    (initget -1 (setq Fusos "17 18 19 20 21 22 23 24 25"))
    (setq Fuso(getkword (strcat "\nSelecione o FUSO [" (vl-string-translate " " "/" Fusos) "]:> ")))
    
    (initget -1 (setq Emisferios "S N"))(setq Emisferio (getkword "\nEmisferio [Sul/Norte]:"))
    
    (initget -1 (setq DATUMList "Sirgas-2000 sAd-69 Corrego"))
    (setq
      DATUM
       (strcase (getkword (strcat "\nSelecione o DATUM [" (vl-string-translate " " "/" DATUMList) "]")) )
    )
    
    (setq
      file(getfiled "Selecione o arquivo KML..." (getvar'dwgprefix) "KML" 8)
      KMLFile(open file "r" "utf8")
      StringDocument ""
    )
    
    (while
      (setq line(read-line KMLFile))
      (setq
        StringDocument (strcat StringDocument line "\n")
      )
    )
    
    (setq
      ListLines(Corrdinate_Getter StringDocument)
      DrawLine '()
    )
    
    (foreach Lines ListLines
      (progn
        (foreach line Lines
          (setq
            DrawLine(append DrawLine (list(car line) (cadr line) (caddr line)))
          )
        )
        (setq
          Vlao
           (vla-add3DPoly
             MSpace
             (vlax-make-variant
               (vlax-safearray-fill
                 (vlax-make-safearray vlax-vbdouble (cons 0 (1-(length DrawLine))))
                 DrawLine
               )
             )
           )
          DrawLine '()
        )
      )
    )
    
  )
  
  (setq
    cad (vlax-get-acad-object)
    doc (vla-get-activedocument cad)
    MSpace (vla-get-modelspace doc)
  )
  
  (vla-startundomark doc)
  (setvar 'cmdecho 0)
  (main)
  (setvar 'cmdecho 1)
  (vla-endundomark doc)
  (princ)
  
)